# FlowSync Backend Environment Configuration Template

# Server Port
PORT=5000

# Runtime Environment (development | production | test)
NODE_ENV=development

# Allowed Frontend Client Origin
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flowsync

# Discrete DB parameters (optional fallback)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=flowsync

# Supabase Configuration for Backend Token Verification
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
